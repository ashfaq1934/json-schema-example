{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/requestType",
      "label": "Request type"
    },
    {
      "type": "Control",
      "scope": "#/properties/fullName",
      "label": "Full name"
    },
    {
      "type": "Control",
      "scope": "#/properties/employeeId",
      "label": "Employee ID",
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/requestType",
          "schema": { "const": "personal" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/companyName",
      "label": "Company name",
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/requestType",
          "schema": { "const": "business" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/vatNumber",
      "label": "VAT number",
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/requestType",
          "schema": { "const": "business" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/priority",
      "label": "Priority"
    },
    {
      "type": "Control",
      "scope": "#/properties/justification",
      "label": "Justification",
      "options": {
        "multi": true
      }
    }
  ]
}
