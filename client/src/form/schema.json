{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/access-request.schema.json",
  "title": "Access request",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestType", "fullName"],
  "properties": {
    "requestType": {
      "type": "string",
      "title": "Request type",
      "enum": ["personal", "business"]
    },
    "fullName": {
      "type": "string",
      "title": "Full name",
      "minLength": 1
    },
    "employeeId": {
      "type": "string",
      "title": "Employee ID",
      "minLength": 1
    },
    "companyName": {
      "type": "string",
      "title": "Company name",
      "minLength": 1
    },
    "vatNumber": {
      "type": "string",
      "title": "VAT number",
      "pattern": "^[A-Z]{2}[A-Z0-9]{2,12}$",
      "description": "Two leading letters, then 2 to 12 letters or digits."
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": ["low", "normal", "urgent"],
      "default": "normal"
    },
    "justification": {
      "type": "string",
      "title": "Justification",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requestType": { "const": "business" }
        },
        "required": ["requestType"]
      },
      "then": {
        "required": ["companyName", "vatNumber"]
      }
    },
    {
      "if": {
        "properties": {
          "requestType": { "const": "personal" }
        },
        "required": ["requestType"]
      },
      "then": {
        "required": ["employeeId"]
      }
    },
    {
      "if": {
        "properties": {
          "priority": { "const": "urgent" }
        },
        "required": ["priority"]
      },
      "then": {
        "required": ["justification"]
      }
    }
  ]
}
